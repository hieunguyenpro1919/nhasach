# Điền thông tin Project Supabase của bạn vào file .env (copy từ file này)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Chỉ dùng khi chạy script seed.mjs để nạp dữ liệu mẫu từ db.json lên Supabase
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key

